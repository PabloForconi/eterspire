---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  url?: string;
}

const { src, alt, url } = Astro.props;
---

{
  url ? (
    <a href={url} target="_blank" rel="noopener">
      <Image src={src} alt={alt} width={480} loading="eager" />
    </a>
  ) : (
    <Image src={src} alt={alt} width={480} loading="eager" />
  )
}

<style>
  a { display: block; }
  img, a :global(img) { width: 100%; height: auto; filter: drop-shadow(0 14px 36px rgb(0 0 0 / 0.6)); }
</style>
