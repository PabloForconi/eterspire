---
import { Image } from 'astro:assets';
import { useT, type Lang } from '../lib/i18n';
import pressOverLogo from '../assets/brand/pressover-logo-white.png';

interface Props {
  lang: Lang;
  links: { id: string; label: string }[];
  /**
   * Adds a first row with the Press Over logo (it scrolls away, like the
   * pressover.news header); only the row of section links stays fixed at the top.
   * Without it, the menu is a single fixed row with the links.
   * On phones the logo moves into the fixed row and the links open from a menu button.
   */
  brand?: boolean;
}

const { lang, links, brand = false } = Astro.props;
const t = useT(lang);
---

{
  brand && (
    <div class="masthead tone-dark no-print">
      <div class="wrap row">
        <a href="#top" class="brand"><Image src={pressOverLogo} alt="Press Over" height={96} class="brand-logo" loading="eager" /></a>
      </div>
    </div>
  )
}
<nav class="nav tone-dark no-print" aria-label={t('contents')}>
  <div class="wrap row">
    {brand && <a href="#top" class="nav-logo"><Image src={pressOverLogo} alt="Press Over" height={64} loading="eager" /></a>}
    <button type="button" class="burger" aria-expanded="false" aria-controls="nav-links" aria-label={t('menu')}>
      <span></span><span></span><span></span>
    </button>
    <ul class="links" id="nav-links">
      {links.map((l) => <li><a href={`#${l.id}`} data-nav={l.id}>{l.label}</a></li>)}
    </ul>
  </div>
</nav>

<script>
  // Highlight the menu link of the section currently on screen. Sections without a link
  // (sub-sections, hidden ones) count as part of the closest linked section before them.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav!, a]),
  );
  const list = document.querySelector<HTMLElement>('.nav .links');
  const owner = new Map<Element, HTMLAnchorElement | undefined>();
  let current: HTMLAnchorElement | undefined;
  for (const s of document.querySelectorAll('main > section')) {
    current = links.get(s.id) ?? current;
    owner.set(s, current);
  }
  // Keep the active link visible inside the (horizontally scrollable) row. This only scrolls the row:
  // scrollIntoView() would also scroll the page and cut short the smooth scroll started by a click.
  const reveal = (a: HTMLAnchorElement) => {
    if (!list) return;
    const left = a.offsetLeft - list.offsetLeft;
    if (left < list.scrollLeft || left + a.offsetWidth > list.scrollLeft + list.clientWidth) {
      list.scrollTo({ left: Math.max(0, left - 24) });
    }
  };
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const active = owner.get(e.target);
        if (!active || active.hasAttribute('aria-current')) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        active.setAttribute('aria-current', 'true');
        reveal(active);
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  owner.forEach((_, s) => observer.observe(s));

  // Fade the right edge of the links while there are more links to the right, so it reads as scrollable.
  const fit = () => list?.classList.toggle('overflowing', list.scrollLeft + list.clientWidth < list.scrollWidth - 1);
  fit();
  addEventListener('resize', fit);
  list?.addEventListener('scroll', fit, { passive: true });

  // Phones: the menu button opens the links as a panel under the bar; picking a link closes it.
  const nav = document.querySelector<HTMLElement>('.nav');
  const burger = nav?.querySelector<HTMLButtonElement>('.burger');
  const setOpen = (open: boolean) => {
    nav?.classList.toggle('open', open);
    burger?.setAttribute('aria-expanded', String(open));
  };
  burger?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
  links.forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

<style>
  .masthead, .nav { background: var(--frame); }
  .row { display: flex; align-items: center; gap: 20px; max-width: 1240px; }

  .masthead .row { justify-content: center; padding-block: 18px 6px; }
  .brand { display: flex; align-items: center; }
  .brand-logo { height: clamp(24px, 3vw, 38px); width: auto; }

  .nav { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--line); }
  .nav .row { height: 54px; }
  /* Centered; when the links don't fit, the row shrinks to the width and scrolls from the first link. */
  .links {
    list-style: none; margin: 0 auto; padding: 0; display: flex; gap: 4px; min-width: 0;
    overflow-x: auto; scrollbar-width: none;
  }
  .nav-logo, .burger { display: none; }
  .links::-webkit-scrollbar { display: none; }
  .links.overflowing { mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent); }
  .links a {
    display: block; padding: 19px 10px 16px; font: 700 12px/1 var(--font-display); letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--body); text-decoration: none; white-space: nowrap;
    border-bottom: 3px solid transparent;
  }
  .links a:hover { color: var(--text); }
  .links a[aria-current] { color: var(--text); border-bottom-color: var(--accent); }

  /* Phones: logo + menu button in the fixed bar, links in a panel that drops down from it. */
  @media (max-width: 640px) {
    .masthead { display: none; }
    .nav .row { height: 48px; justify-content: space-between; }
    .nav-logo { display: flex; align-items: center; }
    .nav-logo img { height: 22px; width: auto; }
    .burger {
      display: flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 40px; height: 40px; margin: 0 -8px 0 auto; padding: 8px; background: none; border: 0; cursor: pointer;
    }
    .burger span { display: block; height: 2px; background: var(--text); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
    .open .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .open .burger span:nth-child(2) { opacity: 0; }
    .open .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .links, .links.overflowing {
      display: none; position: absolute; top: 100%; left: 0; right: 0; margin: 0;
      flex-direction: column; gap: 0; padding: 6px var(--gutter) 14px;
      background: var(--frame); border-bottom: 1px solid var(--line); mask-image: none;
    }
    .nav.open .links { display: flex; }
    .links a { padding: 14px 0 14px 12px; font-size: 13px; border-bottom: 0; border-left: 3px solid transparent; }
    .links a[aria-current] { border-left-color: var(--accent); }
  }
</style>
