---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import pressOverLogo from '../assets/brand/pressover-logo-white.png';
import Proposal from '../layouts/Proposal.astro';
import Cover, { type CoverLayout } from './Cover.astro';
import Intro from './Intro.astro';
import Nav from './Nav.astro';
import Section from './Section.astro';
import Text from './sections/Text.astro';
import Cards from './sections/Cards.astro';
import Stats from './sections/Stats.astro';
import Timeline from './sections/Timeline.astro';
import Table from './sections/Table.astro';
import Pricing from './sections/Pricing.astro';
import Plans from './sections/Plans.astro';
import Cases from './sections/Cases.astro';
import Team from './sections/Team.astro';
import Contact from './sections/Contact.astro';
import { slugify } from '../lib/md';
import { useT } from '../lib/i18n';

interface Props {
  proposal: CollectionEntry<'proposals'>;
  /** Overrides the proposal's `hero.layout` (used to compare cover layouts). */
  layout?: CoverLayout;
}

const { proposal } = Astro.props;
const d = proposal.data;
const layout = Astro.props.layout ?? d.hero.layout;
const t = useT(d.lang);

/** Section `type` → component. Add a block type here and in src/content.config.ts. */
const blocks = { text: Text, cards: Cards, stats: Stats, timeline: Timeline, table: Table, pricing: Pricing, plans: Plans, cases: Cases, team: Team, contact: Contact };

// Sub-sections continue the section before them, so they take its tone unless they set their own.
let parentTone: 'light' | 'dark' = 'light';
const sections = d.sections.map((s, i) => {
  if (!s.sub) parentTone = s.tone ?? 'light';
  return { ...s, id: s.id ?? (slugify(s.nav ?? s.title) || `section-${i + 1}`), tone: s.tone ?? parentTone };
});
const links = sections.filter((s) => !s.hideInNav && !s.sub).map((s) => ({ id: s.id, label: s.nav ?? s.title }));

const coverProps = {
  lang: d.lang, layout, client: d.client, presentedTo: d.presentedTo, date: d.date, validUntil: d.validUntil, meta: d.meta,
  clientLogo: d.clientLogo, clientUrl: d.clientUrl, hero: d.hero,
};
// In "clasica" the Press Over logo is on the cover, so the menu only appears after it.
const menuOnTop = layout !== 'clasica';
---

<Proposal lang={d.lang} title={d.title} description={t('by')} accent={d.theme.accent}>
  <div id="top"></div>
  {menuOnTop && <Nav lang={d.lang} links={links} brand />}
  <Cover {...coverProps} />
  {!menuOnTop && <Nav lang={d.lang} links={links} />}
  {
    menuOnTop && (
      <div class:list={['intro-slot', { overlap: layout === 'ficha' }]}>
        <Intro {...coverProps} card />
      </div>
    )
  }
  <main class="panel">
    {
      sections.map((s) => {
        const Block = blocks[s.type];
        return (
          <Section id={s.id} eyebrow={s.eyebrow} title={s.title} intro={s.intro} sub={s.sub} tone={s.tone} logo={s.logo} fine={s.type === 'text' && s.fine}>
            <Block {...s} lang={d.lang} />
          </Section>
        );
      })
    }
  </main>
  <footer class="footer tone-dark">
    <div class="wrap">
      <a href="https://www.pressover.news" target="_blank" rel="noopener" class="footer-brand">
        <Image src={pressOverLogo} alt="Press Over" height={48} class="footer-logo" />
      </a>
      <span>{d.title}</span>
    </div>
  </footer>
</Proposal>

<style>
  /* The title card sits on the dark frame, between the cover and the white panel. */
  .intro-slot { position: relative; z-index: 2; padding-bottom: clamp(40px, 6vw, 72px); }
  .intro-slot.overlap { margin-top: calc(-1 * var(--overlap)); }
  .footer { padding: 40px 0 56px; font: 600 13px/1.4 var(--font-display); color: var(--muted); }
  .footer .wrap { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .footer-brand { display: block; transition: opacity 0.15s; }
  .footer-brand:hover { opacity: 0.8; }
  .footer-logo { height: 22px; width: auto; }
</style>
