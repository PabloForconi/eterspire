---
import { Image } from 'astro:assets';
import { md } from '../../lib/md';

const { body, image, callout } = Astro.props;
---

<div class:list={['text', { 'with-image': image }]}>
  <div class:list={['prose', { callout }]} set:html={md(body)} />
  {image && <Image src={image} alt="" widths={[480, 960]} sizes="(min-width: 900px) 45vw, 100vw" class="media" />}
</div>

<style>
  .text { font-size: 19px; }
  .media { border-radius: var(--radius); }
  .callout {
    max-width: 860px; padding: 32px 36px; border-radius: var(--radius);
    background: var(--accent-strong); color: #fff; --text: #fff;
  }
  .callout :global(strong) { font-family: var(--font-display); font-weight: 800; font-size: 21px; line-height: 1.35; letter-spacing: -0.01em; }
  @media (min-width: 900px) {
    .with-image { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
  }
  @media (max-width: 899px) { .media { margin-top: 28px; } }
</style>
