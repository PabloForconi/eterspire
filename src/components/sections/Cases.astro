---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { md } from '../../lib/md';

interface Case { title: string; client?: string; body?: string; results: string[]; image?: ImageMetadata; url?: string }
const { items } = Astro.props as { items: Case[] };
---

<div class="grid cols-2">
  {
    items.map((c) => (
      <article class="card case">
        {c.image && <Image src={c.image} alt="" widths={[400, 800]} sizes="(min-width: 720px) 50vw, 100vw" class="thumb" />}
        <div class="body">
          {c.client && <span class="client">{c.client}</span>}
          <h3>{c.url ? <a href={c.url} target="_blank" rel="noopener">{c.title}</a> : c.title}</h3>
          {c.body && <div class="muted" set:html={md(c.body)} />}
          {c.results.length > 0 && <ul class="list">{c.results.map((r) => <li>{r}</li>)}</ul>}
        </div>
      </article>
    ))
  }
</div>

<style>
  .case { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .thumb { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .body { padding: 26px; }
  .client { font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  h3 { font-size: 19px; margin: 8px 0 8px; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--accent-text); }
  .list { margin-top: 14px; }
</style>
