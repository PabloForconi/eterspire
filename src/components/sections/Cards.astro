---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { inline, md } from '../../lib/md';

interface Item { title: string; body?: string; items: string[]; note?: string; tag?: string }
const { items, columns, notes, photos = [] } = Astro.props as { items: Item[]; columns: number; notes?: string; photos?: ImageMetadata[] };
---

<div class={`grid cols-${columns}`}>
  {
    items.map((item, i) => (
      <article class="card">
        <span class="num">{item.tag ?? String(i + 1).padStart(2, '0')}</span>
        <h3>{item.title}</h3>
        {item.body && <div class="muted" set:html={md(item.body)} />}
        {item.items.length > 0 && <ul class="list">{item.items.map((it) => <li set:html={inline(it)} />)}</ul>}
        {item.note && <div class="note" set:html={md(item.note)} />}
      </article>
    ))
  }
</div>
{notes && <div class="notes muted" set:html={md(notes)} />}
{
  photos.length > 0 && (
    <div class="photos" style={`--n: ${photos.length}`}>
      {photos.map((p) => <Image src={p} alt="" widths={[400, 720]} sizes="(min-width: 641px) 30vw, 100vw" />)}
    </div>
  )
}

<style>
  .card { display: flex; flex-direction: column; }
  .num { display: block; font: 800 13px/1 var(--font-display); letter-spacing: 0.1em; color: var(--accent-text); margin-bottom: 18px; }
  h3 { font-size: 18px; margin-bottom: 8px; letter-spacing: -0.015em; }
  .muted, .list { font-size: 15px; }
  .list { margin-top: 6px; }
  .note { margin-top: auto; padding-top: 14px; font-size: 15px; font-weight: 600; color: var(--text); }
  /* Footnote, same as the one under tables. */
  .notes { margin-top: 20px; font-size: 14px; max-width: 76ch; }
  /* One row, every photo cropped to the same frame. */
  .photos { display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 16px; margin-top: 40px; }
  .photos img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); }
  @media (max-width: 640px) { .photos { grid-template-columns: 1fr; } }
</style>
