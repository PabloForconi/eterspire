---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ClientLogo from './ClientLogo.astro';
import Intro from './Intro.astro';
import type { Lang } from '../lib/i18n';
import pressOverLogo from '../assets/brand/pressover-logo-white.png';

/**
 * Cover layouts. In all of them the client logo sits centered over the key art; they differ in where the
 * Press Over logo and the title block (Intro) go:
 * - cabezal: Press Over logo in the sticky menu from the start; the title opens the white panel.
 * - ficha:   like cabezal, but the white panel rises over the bottom of the art, as a card.
 * - clasica: Press Over logo centered at the top of the cover; the title sits in the dark under the logo.
 */
export type CoverLayout = 'cabezal' | 'ficha' | 'clasica';

interface Props {
  lang: Lang;
  layout: CoverLayout;
  client: string;
  presentedTo?: string;
  date: Date;
  validUntil?: Date;
  meta: { label: string; value: string }[];
  clientLogo?: ImageMetadata;
  clientUrl?: string;
  hero: { eyebrow?: string; headline: string; subhead?: string; image?: ImageMetadata };
}

const { layout, clientLogo, clientUrl, client, hero } = Astro.props;
---

<header class:list={['cover', 'tone-dark', `layout-${layout}`]}>
  {
    hero.image && (
      <Image src={hero.image} alt="" widths={[960, 1600, 2400]} sizes="100vw" class="bg" loading="eager" fetchpriority="high" />
    )
  }
  {
    layout === 'clasica' && (
      <div class="top">
        <Image src={pressOverLogo} alt="Press Over" height={72} class="po-logo" loading="eager" />
      </div>
    )
  }
  <div class="emblem">
    <div class="logo">
      {clientLogo ? <ClientLogo src={clientLogo} alt={client} url={clientUrl} /> : <span class="client-name">{client}</span>}
    </div>
  </div>
  {layout === 'clasica' && <div class="title"><Intro {...Astro.props} /></div>}
</header>

<style>
  .cover { position: relative; display: flex; flex-direction: column; overflow: hidden; background: var(--frame); }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% var(--art-y, 50%); opacity: 0.6; }
  /* The banner layouts show a thin strip of the art and the card covers its bottom: frame higher, on the faces. */
  .layout-cabezal .bg, .layout-ficha .bg { --art-y: 22%; }
  /* Vignette: keeps the art visible around a centered logo. */
  .cover::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 55% at 50% 50%, color-mix(in srgb, var(--frame) 35%, transparent), color-mix(in srgb, var(--frame) 80%, transparent) 100%);
  }
  .top, .emblem, .title { position: relative; z-index: 1; }
  .emblem { flex: 1; display: grid; place-items: center; padding: 48px var(--gutter); }
  .logo { width: clamp(260px, 34vw, 480px); }
  .client-name {
    font: 900 clamp(48px, 9vw, 120px)/1 var(--font-display); color: var(--text); letter-spacing: -0.03em; text-transform: uppercase;
  }
  .po-logo { height: clamp(24px, 2.6vw, 32px); width: auto; }

  /* cabezal / ficha: a contained banner (not a full screen), with a moderate logo. */
  .layout-cabezal, .layout-ficha { height: clamp(240px, 30vw, 380px); }
  .layout-cabezal .logo, .layout-ficha .logo { width: clamp(170px, 17vw, 250px); }
  .layout-cabezal .emblem, .layout-ficha .emblem { padding-block: 28px; }
  .layout-cabezal::after, .layout-ficha::after {
    background: color-mix(in srgb, var(--frame) 45%, transparent);
  }
  .layout-cabezal::before, .layout-clasica::before {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 30%; z-index: 1;
    background: linear-gradient(180deg, transparent, var(--frame));
  }
  /* Leave room at the bottom for the card that overlaps the art. */
  .layout-ficha .emblem { padding-bottom: calc(28px + var(--overlap)); }

  .layout-clasica { min-height: 100svh; }
  .layout-clasica::before { height: 60%; background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--frame) 85%, transparent) 40%, var(--frame)); }
  .layout-clasica .top {
    display: flex; justify-content: center; padding: 40px var(--gutter) 0;
  }
  .layout-clasica .emblem { min-height: 56svh; }
  .layout-clasica .title { z-index: 2; }
  .layout-clasica .title :global(.intro) { padding-top: 0; }

  @media (max-width: 720px) {
    .layout-clasica .logo { width: min(280px, 72vw); }
  }
  @media print {
    .cover { min-height: 0; }
    .emblem { min-height: 60vh; }
  }
</style>
