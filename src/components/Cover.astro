---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { md } from '../lib/md';
import { formatDate, useT, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  client: string;
  date: Date;
  validUntil?: Date;
  meta: { label: string; value: string }[];
  clientLogo?: ImageMetadata;
  hero: { eyebrow?: string; headline: string; subhead?: string; image?: ImageMetadata };
}

const { lang, client, date, validUntil, meta, clientLogo, hero } = Astro.props;
const t = useT(lang);
---

<header class="cover">
  {
    hero.image && (
      <Image src={hero.image} alt="" widths={[960, 1600, 2400]} sizes="100vw" class="bg" loading="eager" fetchpriority="high" />
    )
  }
  <div class="wrap inner">
    <div class="brands">
      <span class="po">Press Over</span>
      {
        clientLogo ? (
          <>
            <span class="x" aria-hidden="true">×</span>
            <Image src={clientLogo} alt={client} height={40} class="client-logo" />
          </>
        ) : (
          <>
            <span class="x" aria-hidden="true">×</span>
            <span class="client-name">{client}</span>
          </>
        )
      }
    </div>

    <div class="copy">
      {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
      <h1>{hero.headline}</h1>
      {hero.subhead && <div class="subhead" set:html={md(hero.subhead)} />}
    </div>

    <dl class="meta">
      <div><dt>{t('preparedFor')}</dt><dd>{client}</dd></div>
      <div><dt>{t('date')}</dt><dd>{formatDate(date, lang)}</dd></div>
      {validUntil && <div><dt>{t('validUntil')}</dt><dd>{formatDate(validUntil, lang)}</dd></div>}
      {meta.map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}
    </dl>
  </div>
</header>

<style>
  .cover {
    position: relative; min-height: 100svh; display: flex; overflow: hidden;
    background: radial-gradient(120% 80% at 85% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%), var(--bg);
  }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }
  .cover::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 30%, var(--bg) 100%);
  }
  .inner {
    position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: space-between;
    gap: 48px; padding-top: 32px; padding-bottom: 48px;
  }
  .brands { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .po { font: 700 20px/1 var(--font-display); letter-spacing: -0.01em; }
  .x { color: var(--muted); }
  .client-name { font: 500 18px/1 var(--font-display); color: var(--muted); }
  .client-logo { height: 40px; width: auto; }
  .copy { max-width: 900px; }
  h1 { font-size: clamp(42px, 8vw, 92px); letter-spacing: -0.035em; }
  .subhead { margin-top: 24px; font-size: clamp(18px, 2.2vw, 22px); color: var(--muted); max-width: 640px; }
  .meta { display: flex; flex-wrap: wrap; gap: 16px 48px; margin: 0; border-top: 1px solid var(--line); padding-top: 24px; }
  dt { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  dd { margin: 0; font-weight: 500; }

  @media print {
    .cover { min-height: auto; break-after: page; background: none; }
    .bg, .cover::after { display: none; }
    .inner { padding: 0 0 24px; min-height: 90vh; }
  }
</style>
