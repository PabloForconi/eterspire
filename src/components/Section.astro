---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { md } from '../lib/md';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  /** Continues the previous section: no divider and a smaller heading. */
  sub?: boolean;
  tone?: 'light' | 'dark';
  logo?: ImageMetadata;
  /** Small print: small heading and muted text. */
  fine?: boolean;
}

const { id, eyebrow, title, intro, sub = false, tone = 'light', logo, fine = false } = Astro.props;
---

<section class:list={['section', { sub, fine, 'tone-dark': tone === 'dark' }]} id={id}>
  <div class="wrap">
    <header class="section-head">
      {logo && <Image src={logo} alt="" height={104} class="section-logo" />}
      {eyebrow && <div class="eyebrow"><span class="tag">{eyebrow}</span></div>}
      {sub ? <h3>{title}</h3> : <h2>{title}</h2>}
      {intro && <div class="intro" set:html={md(intro)} />}
    </header>
    <slot />
  </div>
</section>
