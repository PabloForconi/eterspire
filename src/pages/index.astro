---
import { getCollection } from 'astro:content';
import Proposal from '../layouts/Proposal.astro';
import ProposalPage from '../components/ProposalPage.astro';
import { formatDate, withBase } from '../lib/i18n';

// With a single proposal the site root *is* the proposal (e.g. pabloforconi.github.io/eterspire/);
// with several, the root lists them and each one lives at /<slug>/ (see [slug].astro). Always noindex.
const proposals = (await getCollection('proposals', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const only = proposals.length === 1 ? proposals[0] : undefined;
---

{
  only ? (
    <ProposalPage proposal={only} />
  ) : (
    <Proposal lang="en" title="Press Over — Proposals">
      <main class="wrap list-page">
        <span class="eyebrow">Press Over</span>
        <h1>Proposals</h1>
        <ul>
          {proposals.map((p) => (
            <li>
              <a class="card" href={withBase(`${p.id}/`)}>
                <strong>{p.data.client} · {p.data.project}</strong>
                <span class="muted">{p.data.title} — {formatDate(p.data.date, p.data.lang)}</span>
              </a>
            </li>
          ))}
        </ul>
      </main>
    </Proposal>
  )
}

<style>
  .list-page { padding-top: 80px; padding-bottom: 80px; }
  h1 { font-size: 48px; margin-bottom: 32px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .card { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--text); }
  .card:hover { border-color: var(--accent); }
</style>
