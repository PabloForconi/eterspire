---
import { getCollection, type CollectionEntry } from 'astro:content';
import ProposalPage from '../components/ProposalPage.astro';

export async function getStaticPaths() {
  const proposals = await getCollection('proposals', (p) => !p.data.draft);
  // A single proposal is served at the site root (index.astro), so it gets no /<slug>/ copy.
  if (proposals.length < 2) return [];
  return proposals.map((p) => ({ params: { slug: p.id }, props: { proposal: p } }));
}

const { proposal } = Astro.props as { proposal: CollectionEntry<'proposals'> };
---

<ProposalPage proposal={proposal} />
